# Optional. Empty values use automatic discovery under the host home directory.
SMART_RURAL_HOST_HOME=
SMART_RURAL_HOST_CODEX_DIR=
SMART_RURAL_HOST_GH_DIR=
SMART_RURAL_HOST_AGY_DIR=
SMART_RURAL_HOST_GIT_CONFIG=
SMART_RURAL_HOST_SSH_DIR=
# Advanced/testing only; never put credentials in this file.
SMART_RURAL_HOST_IMPORT_IMAGE=
# If the host GH CLI uses a keyring, export GH_TOKEN in the host environment
# for the Dev Container launch. The helper consumes it transiently; do not put
# the token in this file.
# Linux only, optional: expose only the host session-bus socket to the
# short-lived importer, for example /run/user/1000/bus. Do not mount a keyring
# database or the whole XDG runtime directory.
SMART_RURAL_HOST_DBUS_SOCKET=
